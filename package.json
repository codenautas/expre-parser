{
  "name": "expre-parser",
  "description": "expression parser",
  "version": "0.2.1",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "contributors": [
    "Raquel N Salva <raquelzssalva@gmail.com>, Eugenio Arosteguy <eugenio.arosteguy@gmail.com>, Emilio Platzer <emilioplatzer@gmail.com>"
  ],
  "license": "MIT",
  "repository": "codenautas/expre-parser",
  "main": "dist/expre-parser.js",
  "types": "dist/expre-parser.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "sqlite-parser": "~1.0.1"
  },
  "devDependencies": {
    "@types/node": "^14.14.37",
    "@types/mocha": "~8.2.2",
    "mocha": "~8.3.2",
    "typescript": "^4.2.3",
    "discrepances": "~0.2.4",
    "mixin-patch": "~0.3.4"
  },
  "engines": {
    "node": ">= 8.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig-server.json && mixin-patch",
    "watch:buildS": "tsc -p tsconfig-server.json --watch",
    "start": "node dist/server/expre-parser.js",
    "clink": "npm prune && npm i && npm run build && npm link varcal && npm run build",
    "test": "tsc -p tsconfig-test.json && mocha --reporter spec --bail --check-leaks compile-for-test/test/*.js",
    "test-cov": "istanbul cover node_modules/mocha/bin/_mocha -- --reporter dot --check-leaks test/"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "lib",
    "ecmaVersion": 6
  }
}
